<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lasr_perception</name>
  <version>0.1.0</version>
  <description>
    Thin ROS 2 bridge: runs the LASR fixture YOLO model on a camera image
    topic and republishes the boxes as vision_msgs/Detection2DArray for
    fixture_map_test. Detection only -- no depth, no 3D, no geometry.
  </description>
  <maintainer email="jevinekong@gmail.com">jevinekong</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- ultralytics and torch are NOT rosdep keys. Install them into the same
       interpreter that runs this node:  pip install ultralytics
       See the README note about venvs and ROS's system python3. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
